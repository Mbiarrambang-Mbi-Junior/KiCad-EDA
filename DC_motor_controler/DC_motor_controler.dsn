      (pins R1-1 D4-1)
    )
    (net "Net-(D5-A)"
      (pins R1-3 D5-2)
    )
    (net /Trig
      (pins IC1-2 IC1-6)
    )
    (net "/R3{slash}R4"
      (pins R4-1 IC1-3 R3-2)
    )
    (net "Net-(Q2-G)"
      (pins Q2-1 R3-1)
    )
    (class kicad_default /D5 "/R3{slash}R4" /Trig GNDS "Net-(C2-Pad1)" "Net-(D1-A)"
      "Net-(D4-K)" "Net-(D5-A)" "Net-(IC1-CONT)" "Net-(Q2-G)" VCC
      (circuit
        (use_via "Via[0-1]_600:300_um")
      )
      (rule
        (width 200)
        (clearance 200)
      )
    )
  )
  (wiring
  )
)
